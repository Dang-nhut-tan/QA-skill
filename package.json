{
  "name": "qa-agent-system",
  "version": "1.0.0",
  "description": "Evidence-based, CodeGraph-first, human-controlled QA testing workflow with Playwright CLI",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "keywords": [
    "qa",
    "playwright",
    "playwright-cli",
    "automation",
    "testing",
    "codegraph",
    "antigravity"
  ],
  "license": "MIT"
}
